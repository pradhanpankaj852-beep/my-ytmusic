{
  "meta": {
    "name": "YouTube Music Clone",
    "mode": "dark",
    "base": 4,
    "measured_from": "music.youtube.com (web, Nov 2026)"
  },
  "color": {
    "bg":             "#030303",
    "bg-elevated":    "#0f0f0f",
    "surface":        "#1a1a1a",
    "surface-hover":  "#242424",
    "surface-glass":  "rgba(30,30,30,0.55)",
    "border":         "#2a2a2a",
    "border-input":   "#5e5e5e",
    "border-focus":   "#6e9eff",
    "text":           "#e8eaed",
    "text-secondary": "#aaaaaa",
    "text-muted":     "#808080",
    "text-on-accent": "#ffffff",
    "accent":         "#3478c6",
    "accent-hover":   "#4a8ed8",
    "accent-soft":    "rgba(52,120,198,0.15)",
    "danger":         "#f44336",
    "success":        "#4caf50",
    "warning":        "#ff9800",
    "player-glass":   "rgba(18,18,18,0.72)",
    "overlay":        "rgba(0,0,0,0.60)"
  },
  "typography": {
    "family": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "scale": {
      "xs":  "0.6875rem",
      "sm":  "0.75rem",
      "base":"0.875rem",
      "md":  "1rem",
      "lg":  "1.25rem",
      "xl":  "1.75rem",
      "2xl": "2.5rem"
    },
    "leading": { "tight": 1.2, "normal": 1.5 },
    "weight":  { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "spacing": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": {
    "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px"
  },
  "shadow": {
    "sm":   "0 1px 2px rgba(0,0,0,0.3)",
    "md":   "0 4px 12px rgba(0,0,0,0.4)",
    "lg":   "0 8px 32px rgba(0,0,0,0.5)",
    "glow": "0 0 24px rgba(74,144,217,0.25)"
  },
  "glass": {
    "blur": "20px",
    "saturation": "180%"
  },
  "motion": {
    "ease-out":    "cubic-bezier(0.25,0.46,0.45,0.94)",
    "ease-spring": "cubic-bezier(0.34,1.56,0.64,1)",
    "duration-fast":   "120ms",
    "duration-normal": "200ms",
    "duration-slow":   "350ms"
  },
  "layout": {
    "header-height":      56,
    "sidebar-width":      240,
    "mini-player-height": 64,
    "max-content-width":  1440
  },
  "pairs": [
    { "fg": "text",           "bg": "bg",        "ratio_min": 4.5, "actual": 13.9 },
    { "fg": "text-secondary", "bg": "bg",        "ratio_min": 4.5, "actual": 8.2  },
    { "fg": "text-muted",     "bg": "bg",        "ratio_min": 4.5, "actual": 4.6  },
    { "fg": "text",           "bg": "surface",   "ratio_min": 4.5, "actual": 11.4 },
    { "fg": "text-secondary", "bg": "surface",   "ratio_min": 4.5, "actual": 6.7  },
    { "fg": "text-on-accent", "bg": "accent",    "ratio_min": 4.5, "actual": 4.7  },
    { "fg": "border-input",   "bg": "bg",        "ratio_min": 3.0, "actual": 3.1  },
    { "fg": "border-focus",   "bg": "bg",        "ratio_min": 3.0, "actual": 6.9  }
  ]
}
